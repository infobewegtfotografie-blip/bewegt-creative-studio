# Copy to .env for local dev (gitignored) — production values are set in
# the Cloudflare Pages dashboard as environment variables/secrets, never
# committed here.

# Public — bundled into the client build, safe to expose (Turnstile's
# site key is meant to be public; the pairing secret key below is not).
PUBLIC_TURNSTILE_SITE_KEY=

# Server-only secrets — Cloudflare Pages "Environment variables" (mark as
# Secret, not Plaintext).
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@bewegtcreative.com

# Decap CMS OAuth (Phase G) — a GitHub OAuth App pointing at this
# Cloudflare domain's /oauth/callback.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
