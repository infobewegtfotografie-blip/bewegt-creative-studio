---
// Service-packages pricing section. Ported from index.html:318-374.
// `mode="index"` shows the 5-service selector row (homepage); a single
// service slug (e.g. "photo") locks the section to that service for a
// service landing page, matching the legacy per-page pricing blocks.
export interface Props {
  mode: 'index' | 'photo' | 'video' | 'live' | 'design' | 'podcast';
}

const { mode } = Astro.props;
---

<section class="pricing-section" id="pricing" aria-label="Service packages" data-pricing-engine={mode}>
  <div class="section-head">
    <p class="eyebrow" data-i18n="pricing.eyebrow">Service Packages</p>
    <h2 data-i18n="pricing.heading">Flexible packages, tailored production.</h2>
    <p data-i18n="pricing.sub">Choose a service and request a personalized quote.</p>
  </div>

  {mode === 'index' && (
    <div class="pricing-service-row" role="group" aria-label="Select a service">
      <button type="button" class="pricing-service-btn is-active" data-service="photo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
        <span data-i18n="pricing.photo">Photography</span>
      </button>
      <button type="button" class="pricing-service-btn" data-service="video">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2"></rect></svg>
        <span data-i18n="pricing.video">Video</span>
      </button>
      <button type="button" class="pricing-service-btn" data-service="live">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4.93 4.93a10 10 0 0 0 0 14.14M19.07 4.93a10 10 0 0 1 0 14.14M7.76 7.76a6 6 0 0 0 0 8.48M16.24 7.76a6 6 0 0 1 0 8.48"></path><circle cx="12" cy="12" r="2"></circle></svg>
        <span data-i18n="pricing.live">Live streaming</span>
      </button>
      <button type="button" class="pricing-service-btn" data-service="design">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5"></circle><circle cx="17.5" cy="10.5" r=".5"></circle><circle cx="8.5" cy="7.5" r=".5"></circle><circle cx="6.5" cy="12.5" r=".5"></circle><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.93 0 1.5-.79 1.5-1.5 0-.39-.14-.74-.39-1.01-.23-.25-.36-.58-.36-.94 0-.78.62-1.4 1.4-1.4H16c3.31 0 6-2.69 6-6 0-4.96-4.49-9-10-9z"></path></svg>
        <span data-i18n="pricing.design">Graphic design</span>
      </button>
      <button type="button" class="pricing-service-btn" data-service="podcast">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="23"></line><line x1="8" y1="23" x2="16" y2="23"></line></svg>
        <span data-i18n="pricing.podcast">Podcast</span>
      </button>
    </div>
  )}

  <div class="tier-grid">
    <article class="tier-card" data-tier="basic">
      <p class="tier-kicker" data-i18n="pricing.tier.basic">Essential</p>
      <p class="tier-price" data-i18n="pricing.quote">On request</p>
      <p class="tier-desc" data-i18n="pricing.tier.basic.desc">Clean, professional production for individuals, creators and smaller events.</p>
      <ul class="tier-inclusions"></ul>
      <a class="tier-cta" href="#contact" data-i18n="pricing.cta">Request a tailored quote</a>
    </article>
    <article class="tier-card is-featured" data-tier="standard">
      <span class="tier-badge" data-i18n="pricing.tier.standard.badge">Most popular</span>
      <p class="tier-kicker" data-i18n="pricing.tier.standard">Signature</p>
      <p class="tier-price" data-i18n="pricing.quote">On request</p>
      <p class="tier-desc" data-i18n="pricing.tier.standard.desc">Stronger direction, cleaner production and refined post-production for serious projects.</p>
      <ul class="tier-inclusions"></ul>
      <a class="tier-cta" href="#contact" data-i18n="pricing.cta">Request a tailored quote</a>
    </article>
    <article class="tier-card" data-tier="premium">
      <p class="tier-kicker" data-i18n="pricing.tier.premium">Premium</p>
      <p class="tier-price" data-i18n="pricing.quote">On request</p>
      <p class="tier-desc" data-i18n="pricing.tier.premium.desc">Premium productions, brand campaigns and complete creative direction.</p>
      <ul class="tier-inclusions"></ul>
      <a class="tier-cta" href="#contact" data-i18n="pricing.cta">Request a tailored quote</a>
    </article>
  </div>

  <p class="pricing-note" data-i18n="pricing.currency.note">Every project is quoted individually according to scope, location, crew, production and usage rights.</p>
</section>

<script>
  import { initPricingEngine } from '../islands/pricing-engine';
  initPricingEngine();
</script>
