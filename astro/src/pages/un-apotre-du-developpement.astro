---
// Standalone case-study page for the "Un apôtre du développement" book
// project. Ported from un-apotre-du-developpement.html. The legacy page had
// its own bespoke French-only header/footer (no lang switcher, no
// data-i18n) — here it uses the standard BaseLayout/Header/Footer instead
// (lang="fr") so the page gets a working language switcher, sound control
// and lightbox like every other page, rather than a second one-off chrome
// implementation to maintain forever.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Un apôtre du développement — Réalisation BEWEGT"
  description="Direction artistique, design éditorial et campagne de lancement de l'autobiographie Un apôtre du développement par BEWEGT CREATIVE STUDIO."
  path="/un-apotre-du-developpement.html"
  ogImage="/img/projects/un-apotre-du-developpement/couverture-officielle-1200w.webp"
  lang="fr"
>
  <section class="page-hero case-hero">
    <picture>
      <source
        srcset="/img/projects/un-apotre-du-developpement/couverture-officielle-640w.webp 640w, /img/projects/un-apotre-du-developpement/couverture-officielle-1200w.webp 1200w, /img/projects/un-apotre-du-developpement/couverture-officielle.webp 1796w"
        type="image/webp"
      />
      <img
        class="official-cover-media"
        src="/img/projects/un-apotre-du-developpement/couverture-officielle.webp"
        width="1796"
        height="1276"
        alt="Couverture officielle complète du livre Un apôtre du développement"
      />
    </picture>
    <div class="hero-overlay"></div>
    <div class="page-hero-content">
      <p class="eyebrow">Réalisation · Design éditorial</p>
      <h1>Un apôtre du développement</h1>
      <div class="case-meta"><span>Autobiographie</span><span>Direction artistique</span><span>Togo · 2026</span></div>
    </div>
  </section>

  <section class="case-intro">
    <div class="case-intro-text">
      <p class="eyebrow">Le projet</p>
      <h2>Donner une forme éditoriale à une vie de foi et de transmission.</h2>
      <p>Pour la publication de son autobiographie, le Révérend Pasteur Djalla Banako souhaitait une identité visuelle capable de traduire plus de cinquante années d'engagement pastoral et social.</p>
    </div>
    <aside class="case-services">
      <h3>Intervention de BEWEGT</h3>
      <ul>
        <li>Direction artistique</li>
        <li>Première et quatrième de couverture</li>
        <li>Design du dos du livre</li>
        <li>Composition typographique</li>
        <li>Mockups et visuels de présentation</li>
        <li>Affiche de lancement</li>
      </ul>
    </aside>
  </section>

  <section class="case-gallery" aria-label="Galerie du projet">
    <figure class="case-shot case-shot-wide official-cover-frame">
      <img
        class="official-cover-media"
        src="/img/projects/un-apotre-du-developpement/couverture-officielle-1200w.webp"
        srcset="/img/projects/un-apotre-du-developpement/couverture-officielle-640w.webp 640w, /img/projects/un-apotre-du-developpement/couverture-officielle-1200w.webp 1200w, /img/projects/un-apotre-du-developpement/couverture-officielle.webp 1796w"
        sizes="94vw"
        width="1796"
        height="1276"
        alt="Fichier officiel complet : quatrième, dos et première de couverture"
        loading="lazy"
      />
    </figure>
  </section>

  <section class="case-concept">
    <div>
      <p class="eyebrow">La direction créative</p>
      <h2>La foi rencontre le développement humain.</h2>
      <p>L'architecture, les chantiers, l'église et les scènes de transmission composent un paysage symbolique tourné vers la transformation des communautés. Le bleu profond installe une présence institutionnelle et intemporelle, tandis que l'or souligne l'héritage et la dignité du récit.</p>
    </div>
  </section>

  <section class="case-gallery" aria-label="Déploiement de l'identité visuelle">
    <figure class="case-shot case-shot-system">
      <img
        src="/img/projects/un-apotre-du-developpement/book-system-1200w.webp"
        srcset="/img/projects/un-apotre-du-developpement/book-system-640w.webp 640w, /img/projects/un-apotre-du-developpement/book-system-1200w.webp 1200w, /img/projects/un-apotre-du-developpement/book-system.webp 1536w"
        sizes="(max-width:780px) 94vw, 58vw"
        width="1536"
        height="1024"
        alt="Système complet de couverture, dos et quatrième"
        loading="lazy"
      />
    </figure>
    <figure class="case-shot case-shot-poster">
      <img
        src="/img/projects/un-apotre-du-developpement/launch-poster.webp"
        srcset="/img/projects/un-apotre-du-developpement/launch-poster-640w.webp 640w, /img/projects/un-apotre-du-developpement/launch-poster.webp 1086w"
        sizes="(max-width:780px) 94vw, 36vw"
        width="1086"
        height="1448"
        alt="Affiche promotionnelle de la sortie officielle"
        loading="lazy"
      />
    </figure>
  </section>

  <section class="case-production" aria-labelledby="production-title">
    <div class="case-production-copy">
      <p class="eyebrow">De la création au livre</p>
      <h2 id="production-title">Une identité pensée pour devenir un objet imprimé.</h2>
      <p>La couverture a été préparée dans son format complet — quatrième, dos et première — puis déclinée pour accompagner la présentation et la sortie de l'ouvrage.</p>
      <a class="case-download" href="/media/projects/un-apotre-du-developpement/couverture-impression.pdf" target="_blank" rel="noopener" download="Un-apotre-du-developpement-couverture.pdf">
        <span>Voir la couverture d'impression</span>
        <small>PDF · document complet ↗</small>
      </a>
    </div>
    <div class="case-production-media">
      <video controls playsinline preload="metadata" poster="/img/projects/un-apotre-du-developpement/couverture-officielle-640w.webp" aria-label="Aperçu vidéo du livre Un apôtre du développement">
        <source src="/media/projects/un-apotre-du-developpement/apercu-livre.mp4" type="video/mp4" />
        Votre navigateur ne prend pas en charge la lecture vidéo.
      </video>
      <p>Aperçu du livre · juillet 2026</p>
    </div>
  </section>

  <section class="case-cta" id="contact">
    <p class="eyebrow">Votre prochain projet</p>
    <h2>Vous avez un livre ou une histoire à mettre en forme&nbsp;?</h2>
    <a class="btn btn-dark" href="https://wa.me/4917670064700?text=Bonjour%20BEWEGT%20CREATIVE%20STUDIO%2C%20je%20souhaite%20discuter%20d%27un%20projet%20%C3%A9ditorial." target="_blank" rel="noopener">Parlons de votre projet</a>
  </section>
</BaseLayout>
